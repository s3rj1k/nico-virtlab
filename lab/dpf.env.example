# Copy to lab/dpf.env (gitignored). Read by lab/scripts/setup.sh for the dpf flavour, and
# by dpf-net.yaml and sonic.yaml once sourced. CHANGEME values differ per deployment.

# Interface on mgmt that carries the DPU cluster keepalived VIP.
export NICO_DPF_DPU_INTERFACE=ens4
# Free provisioning address outside the MetalLB pools, DPUs reach their control plane here.
export NICO_DPF_DPU_CLUSTER_VIP=192.168.42.199
# Kubernetes API address the DPUs can reach, over WireGuard.
export NICO_DPF_K8S_API_VIP=192.168.42.102
# Empty keeps nvcr.io pulls anonymous. Set an NGC key only for entitled repos.
export NICO_DPF_NGC_API_KEY=
# Defaults to NICO_IMAGE_REGISTRY, where the bluefield images were pushed.
#export NICO_DPF_LAB_REGISTRY=registry.example.com/lab
# Site-wide root password DPF uses for the real BMCs.
#export NICO_DPF_BMC_ROOT_PASSWORD=CHANGEME

# Remote site. The GW box is not part of the heat stack.
export REMOTE_GW_IP=CHANGEME
#export REMOTE_GW_USER=user
# Worker floating IP (heat output worker_floating_ip), the GW dials it on UDP 51820.
export DPF_WG_ENDPOINT=CHANGEME
# Underlay and admin prefixes of lab/patches/values.local.yaml, routed over the tunnel.
export DPF_REMOTE_PREFIXES=10.42.90.0/24,10.42.91.0/24
# GW address on the BMC LAN, the underlay gateway and DHCP relay address.
export REMOTE_GW_LAN_ADDR=10.42.90.1/24
export REMOTE_GW_LAN_IF=CHANGEME
# GW NICs cabled to the DPU ports in order, they become sonic-vs Ethernet0, Ethernet4 and on.
export DPF_DPU_PORTS=CHANGEME
# GW uplink to masquerade the remote prefixes out of, for nvcr.io and BFB downloads.
#export REMOTE_GW_NAT_IF=CHANGEME
